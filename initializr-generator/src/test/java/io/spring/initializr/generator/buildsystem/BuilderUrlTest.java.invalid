package io.spring.initializr.generator.buildsystem;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import java.util.Objects;

public class BuilderUrlTest {
    // Scenario 1: Valid URL Assignment
    @Test
    @Tag("valid")
    public void urlAssignmentWithValidUrl() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        String validUrl = "https://example.com/repo";
        MavenRepository.Builder result = builder.url(validUrl);
        assertEquals(validUrl, builder.url); // Validating URL assignment
        assertSame(builder, result); // Validating method chaining
    }
    // Scenario 2: Null URL Assignment
    @Test
    @Tag("invalid")
    public void urlAssignmentWithNullValue() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        MavenRepository.Builder result = builder.url(null);
        assertNull(builder.url); // Validating URL assignment as null
        assertSame(builder, result); // Validating method chaining
    }
    // Scenario 3: Empty String URL Assignment
    @Test
    @Tag("boundary")
    public void urlAssignmentWithEmptyString() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        String emptyUrl = "";
        MavenRepository.Builder result = builder.url(emptyUrl);
        assertEquals(emptyUrl, builder.url); // Validating empty string URL assignment
        assertSame(builder, result); // Validating method chaining
    }
    // Scenario 4: Long URL Assignment
    @Test
    @Tag("boundary")
    public void urlAssignmentWithLongString() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        String longUrl = "https://example.com/" + "a".repeat(500); // Generating a long URL
        MavenRepository.Builder result = builder.url(longUrl);
        assertEquals(longUrl, builder.url); // Validating long URL assignment
        assertSame(builder, result); // Validating method chaining
    }
    // Scenario 5: Special Character URL Assignment
    @Test
    @Tag("boundary")
    public void urlAssignmentWithSpecialCharacters() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        String specialCharUrl = "https://repo.example.com/!@#$%^&*()";
        MavenRepository.Builder result = builder.url(specialCharUrl);
        assertEquals(specialCharUrl, builder.url); // Validating special character URL assignment
        assertSame(builder, result); // Validating method chaining
    }
    // Scenario 6: URL Comparison After Assignment
    @Test
    @Tag("integration")
    public void urlComparisonAfterAssignment() {
        MavenRepository.Builder builder1 = new MavenRepository.Builder("id1", "https://example.com/repo");
        MavenRepository.Builder builder2 = new MavenRepository.Builder("id2", "https://example.com/repo");
        builder1.url("https://example.com/repo");
        builder2.url("https://example.com/repo");
        MavenRepository repo1 = builder1.build();
        MavenRepository repo2 = builder2.build();
        assertTrue(repo1.equals(repo2)); // Confirming equality based on URL field
    }
    // Scenario 7: URL Assignment with Method Chaining
    @Test
    @Tag("valid")
    public void methodChainingAfterUrlAssignment() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        String validUrl = "https://example.com/repo";
        String validId = "new-id";
        builder.url(validUrl).id(validId);
        assertEquals(validUrl, builder.url); // Validating URL assignment
        assertEquals(validId, builder.id); // Validating ID assignment
    }
    // Scenario 8: Building MavenRepository with URL Set
    @Test
    @Tag("integration")
    public void buildMavenRepositoryWithUrlSet() {
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com/repo");
        String validUrl = "https://example.com/repo";
        builder.url(validUrl);
        MavenRepository repository = builder.build();
        assertEquals(validUrl, repository.url); // Validating URL assignment in built MavenRepository instance
    }
