package io.spring.initializr.generator.buildsystem;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import static org.assertj.core.api.Assertions.assertThat;
import org.junit.jupiter.api.*;
import java.util.Objects;

public class BuilderOnlySnapshotsTest {
    @Test
    @Tag("valid")
    public void snapshotsAreEnabledReleasesAreDisabled() {
        // Arrange
        MavenRepository parentInstance = Mockito.mock(MavenRepository.class);
        MavenRepository.Builder builder = parentInstance.new Builder("repo-id", "http://example.com/repo");
        // Act
        MavenRepository.Builder configuredBuilder = builder.onlySnapshots();
        MavenRepository repository = configuredBuilder.build();
        // Assert
        assertThat(repository.equals(new MavenRepository(configuredBuilder)))
                .isTrue()
                .withFailMessage("Snapshots should be enabled and releases should be disabled for this builder state.");
    }
}