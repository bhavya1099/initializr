package io.spring.initializr.generator.buildsystem;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.junit.jupiter.api.Assertions.assertFalse;
import org.junit.jupiter.api.*;
import java.util.Objects;

public class BuilderOnlyReleasesTest {
    @Test
    @Tag("valid")
    public void enablesReleasesDisablesSnapshots() {
        // Arrange: Initialize the parent container (if needed) and the Builder object
        MavenRepository.Builder builder = new MavenRepository.Builder("test-id", "https://example.com");
        // Act: Call the `onlyReleases` method
        builder.onlyReleases();
        // Assert: Verify that releasesEnabled is true and snapshotsEnabled is false
        MavenRepository repository = builder.build();
        assertTrue(repository.equals(new MavenRepository.Builder("test-id", "https://example.com").releasesEnabled(true).snapshotsEnabled(false).build()),
                "Releases should be enabled, snapshots disabled.");
    }
}