package io.spring.initializr.generator.buildsystem;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.assertj.core.api.Assertions.assertThat;
import org.junit.jupiter.api.*;
import java.util.Objects;

public class BuilderReleasesEnabledTest {
    @Test
    @Tag("valid")
    public void releasesEnabledTrueReturnsBuilderInstance() {
        // Arrange
        MavenRepository parentRepository = new MavenRepository();
        MavenRepository.Builder builder = parentRepository.new Builder("test-id", "http://test-url.com");
        // Act
        MavenRepository.Builder result = builder.releasesEnabled(true);
        // Assert
        assertThat(result).isSameAs(builder);
        assertThat(((MavenRepository.Builder) result).releasesEnabled).isTrue();
    }
    @Test
    @Tag("invalid")
    public void releasesEnabledFalseReturnsBuilderInstance() {
        // Arrange
        MavenRepository parentRepository = new MavenRepository();
        MavenRepository.Builder builder = parentRepository.new Builder("test-id", "http://test-url.com");
        // Act
        MavenRepository.Builder result = builder.releasesEnabled(false);
        // Assert
        assertThat(result).isSameAs(builder);
        assertThat(((MavenRepository.Builder) result).releasesEnabled).isFalse();
    }
    @Test
    @Tag("boundary")
    public void releasesEnabledBoundaryWithNullInput() {
        // Arrange
        MavenRepository parentRepository = new MavenRepository();
        MavenRepository.Builder builder = parentRepository.new Builder("test-id", "http://test-url.com");
        // Act & Assert
        // Ensure that releasesEnabled cannot accept null as this would lead to compilation error. 
