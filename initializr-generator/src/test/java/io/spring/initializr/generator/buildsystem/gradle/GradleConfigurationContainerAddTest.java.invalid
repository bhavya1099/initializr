package io.spring.initializr.generator.buildsystem.gradle;
import java.util.LinkedHashSet;
import java.util.Set;
import org.junit.jupiter.api.Test;
import static org.assertj.core.api.Assertions.assertThat;
import static org.junit.jupiter.api.Assertions.assertThrows;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.function.Consumer;
import java.util.stream.Stream;
import io.spring.initializr.generator.buildsystem.gradle.GradleConfiguration.Builder;

public class GradleConfigurationContainerAddTest {
    private static class GradleConfigurationContainer {
        private final Set<String> configurations = new LinkedHashSet<>();
        public void add(String name) {
            if (name == null) {
                throw new NullPointerException("Configuration name cannot be null");
            }
            this.configurations.add(name);
        }
    }
    @Test
    public void addValidConfigurationName() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        String validName = "testConfig";
        container.add(validName);
        assertThat(container.configurations).contains(validName);
        assertThat(container.configurations.size()).isEqualTo(1);
    }
    @Test
    public void addDuplicateConfigurationName() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        String duplicateName = "duplicateConfig";
        container.add(duplicateName);
        container.add(duplicateName);
        assertThat(container.configurations).contains(duplicateName);
        assertThat(container.configurations.size()).isEqualTo(1);
    }
    @Test
    public void addMultipleConfigurationNames() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        String[] names = {"config1", "config2", "config3"};
        for (String name : names) {
            container.add(name);
        }
        assertThat(container.configurations).containsExactlyInAnyOrder(names);
        assertThat(container.configurations.size()).isEqualTo(names.length);
    }
    @Test
    public void addToEmptySet() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        String firstName = "firstConfig";
        container.add(firstName);
        assertThat(container.configurations).contains(firstName);
        assertThat(container.configurations.size()).isEqualTo(1);
    }
    @Test
    public void addNullConfigurationName() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        assertThrows(NullPointerException.class, () -> container.add(null));
    }
    @Test
    public void verifyOrderOfAddedConfigurations() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        String[] orderedNames = {"configA", "configB", "configC"};
        for (String name : orderedNames) {
            container.add(name);
        }
        assertThat(container.configurations.toArray()).containsExactly((Object[]) orderedNames);
    }
    @Test
    public void addSpecialCharacterConfiguration() {
        GradleConfigurationContainer container = new GradleConfigurationContainer();
        String specialName = "config$@!";
        container.add(specialName);
        assertThat(container.configurations).contains(specialName);
        assertThat(container.configurations.size()).isEqualTo(1);
    }
}