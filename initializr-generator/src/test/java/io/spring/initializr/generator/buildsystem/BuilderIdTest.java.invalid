package io.spring.initializr.generator.buildsystem;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import org.junit.jupiter.api.*;
import java.util.Objects;

public class BuilderIdTest {
    @Test
    @Tag("valid")
    public void setIdSuccessfully() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        MavenRepository.Builder returnedBuilder = builder.id("repositoryId");
        assertEquals("repositoryId", builder.id); // Ensure id is set correctly
        assertEquals(returnedBuilder, builder); // Ensure method chaining works
    }
    @Test
    @Tag("invalid")
    public void setIdAsNull() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        MavenRepository.Builder returnedBuilder = builder.id(null);
        assertEquals(null, builder.id); // Ensure id is set to null
        assertEquals(returnedBuilder, builder); // Ensure method chaining works
    }
    @Test
    @Tag("valid")
    public void idMethodChaining() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        builder.id("repositoryId")
               .name("repositoryName")
               .url("https://repo.url")
               .releasesEnabled(true);
        assertEquals("repositoryId", builder.id); 
        assertEquals("repositoryName", builder.name); 
        assertEquals("https://repo.url", builder.url); 
        assertEquals(true, builder.releasesEnabled);
    }
    @Test
    @Tag("valid")
    public void idAffectsRepositoryEquality() {
        MavenRepository parent1 = new MavenRepository();
        MavenRepository parent2 = new MavenRepository();
        MavenRepository.Builder builder1 = parent1.new Builder("repo1", "https://repo1.url");
        MavenRepository.Builder builder2 = parent2.new Builder("repo2", "https://repo2.url");
        MavenRepository repo1 = builder1.build();
        MavenRepository repo2 = builder2.build();
        assertEquals(false, repo1.equals(repo2)); // Ensure objects with different ids are not equal
    }
    @Test
    @Tag("boundary")
    public void handleIdWithSpecialCharacters() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        MavenRepository.Builder returnedBuilder = builder.id("@repo#123");
        assertEquals("@repo#123", builder.id); // Ensure id with special characters is set correctly
        assertEquals(returnedBuilder, builder); // Ensure method chaining works
    }
    @Test
    @Tag("integration")
    public void idFieldInteractionWithOtherMethods() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        builder.id("repositoryId")
               .name("repositoryName")
               .url("https://repo.url")
               .releasesEnabled(true);
        MavenRepository repo = builder.build();
        assertEquals("repositoryId", repo.id); 
        assertEquals("repositoryName", repo.name); 
        assertEquals("https://repo.url", repo.url); 
        assertEquals(true, repo.releasesEnabled);
    }
    @Test
    @Tag("valid")
    public void validateIdMethodInIsolation() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        builder.id("repositoryId");
        assertEquals("repositoryId", builder.id); 
        assertEquals(null, builder.name); // Ensure other fields are unset
        assertEquals(null, builder.url); // Ensure other fields are unset
        assertEquals(false, builder.releasesEnabled); // Default value
    }
    @Test
    @Tag("boundary")
    public void handleEmptyStringForId() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        MavenRepository.Builder returnedBuilder = builder.id("");
        assertEquals("", builder.id); // Ensure empty string id is set correctly
        assertEquals(returnedBuilder, builder); // Ensure method chaining works
    }
    @Test
    @Tag("boundary")
    public void idDefaultValue() {
        MavenRepository parent = new MavenRepository();
        MavenRepository.Builder builder = parent.new Builder("defaultId", "defaultUrl");
        MavenRepository repo = builder.build();
        assertEquals(null, repo.id); // Ensure id defaults to null
    }
}