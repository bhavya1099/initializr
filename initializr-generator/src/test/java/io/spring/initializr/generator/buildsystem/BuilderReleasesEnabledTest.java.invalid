    @Test
    @Tag("integration")
    public void releasesEnabledIntegrationWithChainedBuilderUsage() {
        // Arrange
        MavenRepository parentRepository = new MavenRepository();
        MavenRepository.Builder builder = parentRepository.new Builder("test-id", "http://test-url.com");
        // Act
        MavenRepository.Builder result = builder.releasesEnabled(true).id("new-test-id").name("New Name");
        // Assert
        assertThat(result).isSameAs(builder);
        assertThat(((MavenRepository.Builder) result).releasesEnabled).isTrue();
        assertThat(((MavenRepository.Builder) result).id).isEqualTo("new-test-id");
        assertThat(((MavenRepository.Builder) result).name).isEqualTo("New Name");
    }
